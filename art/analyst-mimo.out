    # Try to decode
    padded = decoded_h + '=' * (4 - len(decoded_h) % 4)
    try:
        raw = base64.b64decode(padded)
        print(f'HMAC {i}: hex={raw.hex()[:32]}... len={len(raw)} bytes')
    except:
        print(f'HMAC {i}: decode failed, len={len(decoded_h)} chars')
